@article{KIUCHI1983961,
title = {The solubility and diffusivity of hydrogen in well-annealed and deformed iron},
journal = {Acta Metallurgica},
volume = {31},
number = {7},
pages = {961-984},
year = {1983},
issn = {0001-6160},
doi = {https://doi.org/10.1016/0001-6160(83)90192-X},
url = {https://www.sciencedirect.com/science/article/pii/000161608390192X},
author = {K. Kiuchi and R.B. McLellan},
abstract = {It has been shown that a large volume of data for the solubility of hydrogen in iron is affected by spurious surface conditions. Arrhenius plots of solubility data in the temperature range 300–1750 K, which are free of such effects, exhibit a temperature variation which, despite the low H-solubility in the entire temperature range, is not consistent with regular mixing statistics. This departure from regular behavior is consistent with the thermal activation of H atoms into energetically less favorable octahedral sites as the temperature is increased. The enhancement in H-solubility caused by the cold deformation of iron can be understood in terms of a simple Maxwell-Boltzmann distribution of H atoms between “normal” lattice sites and “trapping” sites of depth 34 kJ/mol. The 62 currently existing sets of data for the diffusivity D of hydrogen through b.c.c. iron exhibit a large degree of mutual inconsistency. Exhaustive statistical analysis of this large data mass has shown that only those data obtained by electrochemical methods and H2-gas equilibration methods using UHV techniques and Pd-coated membranes are reliable. In the range −40–80°C the best representation of D is D = 7.23 x 10−8 exp (−Q/RT)m2/s where Q = 5.69 kJ/mol. In the temperature range 50°–550°C, the best D-representation is D = (1−2.52) x 10−7 exp (−|Q/RT)m2/s with Q in the range 6.70–7.12 kJ/moI. These differing diffusivities are consistent with an increase with temperature of the fraction of H-atoms hopping from octahedral rather than tetrahedral sites. The problem of H-diffusion in deformed iron has been analysed using a semi-quantitative model in which the retarding effect of trapping sites on the diffusivity is partially compensated by a “pipe” diffusion contribution along dislocations. It is shown that this model is in accord with the diffusivities measured in deformed iron when data not encumbered by spurious surface effects are considered.
Résumé
On a montré que de nombreuses données concernant la solubilité de l'hydrogène dans le fer étaient affectées par de mauvaises conditions de la surface. Des courbes d'Arrhenius de la solubilité entre 300 et 1750 K, ne présentant pas ces effets, varient en fonction de la température d'une manière qui n'est pas compatible avec la statistique du mélange régulier, malgré la faible solubilité de l'hydrogène dans tout le domaine de températures. Cet écart par rapport au comportement régulier est compatible avec l'activation thermique d'atomes d'hydrogène dans des sites octaédriques moins favorables énergétiquement lorsque la température augmente. On peut comprendre l'augmentation de la solubilité de l'hydrogène provoquée par l'écrouissage du fer comme une simple distribution de Maxwell et Boltzmann des atomes d'hydrogène entre des sites réticulaires “normaux” et des sites “pièges” de profondeur 34 kj/mol. Les soixante-deux ensembles de valeurs pour la diffusivité D de l'hydrogène dans le fer c.c. présentent un fort degré d'incohérence mutuelle. Une analyse statistique complète de cette grande masse de résultats a montré que seules les données obtenues par les méthodes éiectrochimiques et par les méthodes d'équilibrage du gaz H2 utilisant des techniques UHV et des membranes à revêtement de Pd, sont sûres. Entre −40 et 80°C, la meilleure représentation de D est D = 7,23 x 10−8exp (−Q/RT) m2/s où Q = 5,69 kJ/mol. Entre 50 et 550°C, la meilleure représentation de D est D = (1−2,52) x 10−7exp (−Q/RT) m2/s où Q est compris entre 6,70 et 7,12 kJ/mol. Ces différentes diffusivités sont cohérentes avec une augmentation du taux d'atomes d'hydrogène sautant de sites octaédriques plutôt que de sites tétraédriques, lorsqu'on augmente la température.
Zusammenfassung
Viele Ergebnisse über die Löslichkeit von Wasserstoff sind, wie gezeigt worden ist, durch Oberflächeneflekte beeinfluβt. Arrheniusauftragungen von unbeeinfluβten Ergebnissen zeigen, zwischen 300–1750 K ein Temperaturverhalten, welches trotz der niedrigen Wasserstofflöslichkeit im gesamten Temperaturbereich nicht mit der regulären Mischungsstatislik verträglich ist. Diese Abweichung vom regulären Verhalten entspricht einer bei steigenden Temperaturen thermisch aktivierten Bewegung von H-Atomen in energetisch ungünstigere Oktaederplätze. Die durch die Kaltverformung des Eisens verstärkte H-Löslichkeit kann mit einer einfachen Maxwell-Bollzmann-Verteilung der H-Atome zwischen ‘normalen’ Gitterplätzen und Fallen mit einer Energie von 34 kJ/Mol beschrieben werden. Die gegenwärtig vorliegenden zweiundsechzig Datensätze für die Diffusivität D des Wassersloffs in krz, Eisen sind miteinander weitgehend unvertraglich. Mit einer ausführlichen Analyse aller dieser Daten konnte gezeígt werden, daβ nur die Daten verläβlich sind, die elektrochemiseh und mit Methoden der H2-Gas-Gleichgewichtseinstellung im Ultrahochvakuum unter Nutzung von Pd-bedeckten Membranen erhalten wurden. Im Temperaturbereich — 40 → 80°C kann D am besten mit D = 7,23 x 10−8 exp (−Q/RT) m2/s dargestellt werden; Q beträgt 5,69 kJ/Mol. Im Temperaturbereich 50°–550°C kann D am besten mit D = [1−2,52] x 10−7 exp (−Q/RT) m2/s dargestellt werden; Q beträgt 6,70–7,12 kJ/Mol. Diese unterschiedlichen Diffusitäten entsprechen dem zunehmenden Anteil an H-Atomen, die bei erhöhter Temperatur auf Oktaederplätze statt auf Tetraederplätze springen. Das Problem der H-Diffusion bei verformtem Eisen ist an einem semi-quantitativen Modell untersucht worden, bei dem der Verzögerungseflekt durch Fallen auf die Diffusität teilweise durch den Beitrag der Diffusion durch ein Rohr entlang der Verschiebung kompensiert wurde. Es wird gezeigt, daβ dieses Modell mit den Diffusitätswerten übereinstimmt, die in verformtem Eisen gemessen werden, bei dem keine Oberflächeneffekte zu berücksichtigen sind.}
}

